{
  "name": "agent-notify",
  "version": "0.1.0",
  "description": "Local-first durable IM notification delivery for coding agents",
  "license": "MIT",
  "homepage": "https://github.com/qiyuey/agent-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyuey/agent-notify.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "bin": {
    "agent-notify": "dist/cli.js",
    "agent-notify-daemon": "dist/daemon.js"
  },
  "keywords": [
    "agent",
    "codex",
    "pi",
    "telegram",
    "notifications",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run smoke:dist && npm run validate:plugin && npm run test:mcp",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "start": "node --env-file-if-exists=.env dist/daemon.js",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "test": "vitest run",
    "test:mcp": "node --test scripts/test-mcp.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:plugin": "node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "grammy": "^1.46.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/node-fetch": "2.6.13",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
